# Скопіюйте у змінні середовища Vercel (Project → Settings → Environment Variables).
# Для локальної розробки: `vercel env pull .env.local`.

# Ключ Anthropic. Лежить ТІЛЬКИ тут, у браузер не потрапляє.
ANTHROPIC_API_KEY=

# Ваш токен доступу до проксі (довгий випадковий рядок).
# Згенерувати: openssl rand -base64 32
APP_TOKEN=

# Ліміти витрат у доларах (за замовчуванням 3 на день і 30 на місяць).
DAILY_LIMIT_USD=3
MONTHLY_LIMIT_USD=30

# Часовий пояс, у якому «день» і «місяць» скидаються (за замовчуванням Europe/Kyiv).
BUDGET_TZ=Europe/Kyiv

# Верхня межа max_tokens в одному запиті (за замовчуванням 16000).
MAX_OUTPUT_TOKENS=16000

# Redis для лічильника витрат: Vercel → Storage → Marketplace → Upstash Redis.
# Інтеграція додає змінні сама. Підтримуються обидві пари імен:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Лише для локальних тестів без Redis (на Vercel не ставити!):
# BUDGET_STORE=memory

# Необов'язково: свої ціни (долари за 1 млн токенів), якщо вони змінилися.
# PRICES_JSON={"claude-sonnet-5-5":{"in":2,"out":10,"cacheRead":0.1,"cacheWrite":2.5}}
